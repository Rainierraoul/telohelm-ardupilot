<?xml version="1.0"?>
<sdf version="1.9"><world name="studio">
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.8 0.9 1</background><sky></sky><shadows>true</shadows></scene>
<light type="directional" name="sun"><cast_shadows>true</cast_shadows><direction>-0.4 0.3 -0.8</direction><diffuse>1 1 1 1</diffuse><specular>0.3 0.3 0.3 1</specular></light>
