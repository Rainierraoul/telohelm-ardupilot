<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cine_field_ground"><static>true</static>
    <link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry></collision>
      <visual name="v"><cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>meshes/ground.obj</uri></mesh></geometry>
        <material><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><albedo_map>materials/textures/ground_color.jpg</albedo_map>
            <normal_map>materials/textures/ground_normal.jpg</normal_map>
            <roughness_map>materials/textures/ground_roughness.jpg</roughness_map><metalness>0.0</metalness></metal></pbr>
        </material></visual>
    </link></model>
</sdf>
